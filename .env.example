# BenchProof runtime configuration
# Copy to .env and fill values you actually have. Do not commit secrets.

# Public site (safe to expose)
VITE_PUBLIC_HOSTNAME=https://benchproof.bydx.fun
VITE_AUTH_ENABLED=false

# Public GenLayer network (safe to expose)
VITE_GENLAYER_NETWORK=studionet
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_RPC=https://studio.genlayer.com/api
VITE_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com
VITE_GENLAYER_CONTRACT_ADDRESS=0x2368a42582710f61AF4f29A432990328db32a2ec
VITE_GENLAYER_DEPLOYMENT_TX=0xd2b875600a60ef8bff48488441a4e9183940adde5cb6de46e5b5df02637669fa
VITE_GENLAYER_EVALUATION_TX=0x3ce022d3e3874f85854c74e307a6acf231892b9563c459916acd4f699ca7be6a

# Optional server-side write keys for Studio deploy / faucet (never VITE_)
GENLAYER_DEPLOYER_PRIVATE_KEY=
GENLAYER_CHALLENGER_PRIVATE_KEY=

# Persistence: PostgreSQL URL, or file-backed PGlite directory in production
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional server-only xAI access (never VITE_)
XAI_API_KEY=

# Optional auth (off by default for this product)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PROJECT_ID=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
GROK_GATE_ORIGIN=
